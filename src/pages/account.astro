<script>
  import { currentUser, loginUser, logout, registerUser, updateNickname, type StoredUser } from '~/scripts/auth-store';

  type Mode = 'login' | 'register';

  let guestView: HTMLElement | null = null;
  let accountView: HTMLElement | null = null;
  let tabsRoot: HTMLElement | null = null;
  let loginForm: HTMLFormElement | null = null;
  let registerForm: HTMLFormElement | null = null;
  let titleEl: HTMLElement | null = null;
  let subtitleEl: HTMLElement | null = null;
  let errorEl: HTMLElement | null = null;
  let noticeEl: HTMLElement | null = null;
  let nickInput: HTMLInputElement | null = null;
  let nickNote: HTMLElement | null = null;
  let nickNoteTimer: number | undefined;

  const PREF_PREFIX = 'amethyst:prefs:';

  const pick = <T extends Element>(selector: string) => document.querySelector<T>(selector);

  const clearMessages = () => {
    errorEl?.classList.add('hidden');
    noticeEl?.classList.add('hidden');
    if (errorEl) errorEl.textContent = '';
    if (noticeEl) noticeEl.textContent = '';
  };

  const showError = (message: string) => {
    if (!errorEl) return;
    if (noticeEl) noticeEl.classList.add('hidden');
    errorEl.textContent = message;
    errorEl.classList.remove('hidden');
  };

  const showNotice = (message: string) => {
    if (!noticeEl) return;
    if (errorEl) errorEl.classList.add('hidden');
    noticeEl.textContent = message;
    noticeEl.classList.remove('hidden');
  };

  const setMode = (mode: Mode) => {
    if (!tabsRoot || !loginForm || !registerForm) return;

    tabsRoot.dataset.mode = mode;
    tabsRoot.querySelectorAll<HTMLButtonElement>('[data-tab]').forEach((tab) => {
      const active = tab.dataset.tab === mode;
      tab.dataset.active = String(active);
      tab.setAttribute('aria-selected', String(active));
    });

    const activeForm = mode === 'login' ? loginForm : registerForm;
    const inactiveForm = mode === 'login' ? registerForm : loginForm;
    inactiveForm.hidden = true;
    activeForm.hidden = false;
    activeForm.classList.remove('auth-form-in');
    void activeForm.offsetWidth;
    activeForm.classList.add('auth-form-in');

    if (titleEl) titleEl.textContent = mode === 'login' ? 'С возвращением' : 'Создай свой Amethyst ID';
    if (subtitleEl) {
      subtitleEl.textContent =
        mode === 'login'
          ? 'Войди, чтобы забрать сетап на любое устройство.'
          : 'Десять секунд — и косметика всегда с тобой.';
    }

    clearMessages();
    activeForm.querySelector<HTMLInputElement>('input')?.focus({ preventScroll: true });
  };

  const readPrefs = (email: string): Record<string, boolean> => {
    try {
      return JSON.parse(localStorage.getItem(PREF_PREFIX + email) || '{}');
    } catch {
      return {};
    }
  };

  const applyPrefs = (email: string) => {
    const prefs = readPrefs(email);
    document.querySelectorAll<HTMLInputElement>('[data-sync]').forEach((input) => {
      input.checked = prefs[input.dataset.sync || ''] !== false;
    });
  };

  /* ── Dashboard panels ─────────────────────────────────────────────── */
  const PANELS = ['overview', 'friends', 'configs', 'events'] as const;
  const FRIEND_PREFIX = 'amethyst:friends:';
  type Panel = (typeof PANELS)[number];

  const PRESET_PREFIX = 'amethyst:preset:';
  let countdownTimer: number | undefined;

  const openPanel = (panel: Panel, updateHash = true) => {
    const account = document.querySelector<HTMLElement>('[data-view="account"]');
    if (!account) return;

    account.querySelectorAll<HTMLElement>('[data-acc-tab]').forEach((tab) => {
      const active = tab.dataset.accTab === panel;
      tab.dataset.active = String(active);
      tab.setAttribute('aria-selected', String(active));
    });

    account.querySelectorAll<HTMLElement>('[data-acc-panel]').forEach((section) => {
      const active = section.dataset.accPanel === panel;
      section.hidden = !active;
      if (active) {
        section.classList.remove('acc-panel-in');
        void section.offsetWidth;
        section.classList.add('acc-panel-in');
      }
    });

    if (updateHash) {
      const next = panel === 'overview' ? `${window.location.pathname}${window.location.search}` : `#${panel}`;
      window.history.replaceState(null, '', next);
    }
  };

  const setActivePreset = (name: string) => {
    document.querySelectorAll<HTMLElement>('[data-preset]').forEach((card) => {
      const active = card.dataset.name === name;
      card.dataset.active = String(active);
      card.classList.toggle('border-violet-300/50', active);
      card.classList.toggle('border-white/10', !active);
      card.querySelector<HTMLElement>('[data-preset-badge]')?.classList.toggle('hidden', !active);
    });
  };

  const applyActivePreset = (email: string) => {
    const stored = localStorage.getItem(PRESET_PREFIX + email);
    if (stored) setActivePreset(stored);
  };

  const showPanelNote = (panel: 'friends' | 'configs', message: string, tone: 'ok' | 'error' = 'ok') => {
    const note = document.querySelector<HTMLElement>(`[data-${panel}-note]`);
    if (!note) return;
    note.textContent = message;
    note.dataset.tone = tone;
    note.classList.remove('hidden');
    window.setTimeout(() => note.classList.add('hidden'), 2800);
  };

  const updateFriendCounters = () => {
    const rows = Array.from(document.querySelectorAll<HTMLElement>('[data-friend]'));
    const online = rows.filter((row) => row.dataset.online === 'true').length;

    const onlineEl = document.querySelector<HTMLElement>('[data-friends-online]');
    const totalEl = document.querySelector<HTMLElement>('[data-friends-total]');
    const badgeEl = document.querySelector<HTMLElement>('[data-friends-badge]');
    if (onlineEl) onlineEl.textContent = String(online);
    if (totalEl) totalEl.textContent = String(rows.length);
    if (badgeEl) badgeEl.textContent = String(online);

    const requests = document.querySelectorAll('[data-request]').length;
    const requestsBadge = document.querySelector<HTMLElement>('[data-requests-badge]');
    if (requestsBadge) {
      requestsBadge.textContent = String(requests);
      requestsBadge.classList.toggle('hidden', requests === 0);
    }

    const friendsEmpty = document.querySelector<HTMLElement>('[data-friends-empty]');
    if (friendsEmpty) friendsEmpty.hidden = rows.length > 0;

    const requestsEmpty = document.querySelector<HTMLElement>('[data-requests-empty]');
    if (requestsEmpty) requestsEmpty.hidden = requests > 0;
  };

  const readFriends = (email: string): string[] => {
    try {
      const parsed = JSON.parse(localStorage.getItem(FRIEND_PREFIX + email) || '[]');
      return Array.isArray(parsed) ? parsed.filter((nick) => typeof nick === 'string') : [];
    } catch {
      return [];
    }
  };

  const saveFriends = (email: string, names: string[]) => {
    const unique: string[] = [];
    const seen = new Set<string>();
    names.forEach((nick) => {
      const key = nick.toLowerCase();
      if (seen.has(key)) return;
      seen.add(key);
      unique.push(nick);
    });
    localStorage.setItem(FRIEND_PREFIX + email, JSON.stringify(unique.slice(0, 100)));
  };

  const friendNames = () =>
    Array.from(document.querySelectorAll<HTMLElement>('[data-friend-name]'))
      .map((element) => element.textContent?.trim() || '')
      .filter((name) => name.length > 0);

  const persistFriends = () => {
    const user = currentUser();
    if (!user) return;
    saveFriends(user.email, friendNames());
  };

  const renderFriends = (email: string) => {
    const list = document.querySelector<HTMLElement>('[data-friend-list]');
    if (!list) return;
    list.replaceChildren();
    readFriends(email)
      .slice()
      .reverse()
      .forEach((nick) => addFriendRow(nick, false, false));
    updateFriendCounters();
  };

  const addFriendRow = (nick: string, online = false, persist = false) => {
    const list = document.querySelector<HTMLElement>('[data-friend-list]');
    const template = document.querySelector<HTMLTemplateElement>('[data-friend-template]');
    const node = template?.content.firstElementChild?.cloneNode(true) as HTMLElement | null;
    if (!list || !node) return;

    const duplicate = Array.from(list.querySelectorAll<HTMLElement>('[data-friend-name]')).some(
      (element) => (element.textContent?.trim() || '').toLowerCase() === nick.toLowerCase()
    );
    if (duplicate) return;

    const row = node;
    row.dataset.online = String(online);

    const avatar = row.querySelector<HTMLElement>('[data-friend-avatar]');
    if (avatar) {
      const dot = avatar.querySelector('[data-friend-dot]');
      avatar.textContent = nick.slice(0, 1).toUpperCase();
      if (dot) avatar.append(dot);
    }

    const dot = row.querySelector<HTMLElement>('[data-friend-dot]');
    dot?.classList.toggle('bg-emerald-400', online);
    dot?.classList.toggle('bg-white/25', !online);

    const nameEl = row.querySelector<HTMLElement>('[data-friend-name]');
    const statusEl = row.querySelector<HTMLElement>('[data-friend-status]');
    if (nameEl) nameEl.textContent = nick;
    if (statusEl) statusEl.textContent = online ? 'В сети · только что' : 'не в сети';

    const invite = row.querySelector<HTMLButtonElement>('[data-friend-invite]');
    if (invite) {
      invite.textContent = 'Пригласить';
      invite.disabled = false;
    }

    list.prepend(row);
    updateFriendCounters();
    if (persist) persistFriends();
  };

  const addPresetCard = (name: string) => {
    const grid = document.querySelector<HTMLElement>('[data-config-grid]');
    const cards = grid?.querySelectorAll<HTMLElement>('[data-preset]');
    if (!grid || !cards || cards.length === 0) return;

    const source = cards[Math.floor(Math.random() * cards.length)];
    const card = source.cloneNode(true) as HTMLElement;
    card.dataset.name = name;
    card.dataset.active = 'false';
    card.classList.remove('border-violet-300/50');
    card.classList.add('border-white/10');

    const nameEl = card.querySelector<HTMLElement>('[data-preset-name]');
    const metaEl = card.querySelector<HTMLElement>('[data-preset-meta]');
    if (nameEl) nameEl.textContent = name;
    if (metaEl) metaEl.textContent = 'новый · 0 модулей';
    card.querySelector<HTMLElement>('[data-preset-badge]')?.classList.add('hidden');

    grid.prepend(card);

    const badge = document.querySelector<HTMLElement>('[data-configs-badge]');
    if (badge) badge.textContent = String(grid.querySelectorAll('[data-preset]').length);
  };

  const downloadJson = (filename: string, payload: unknown) => {
    const blob = new Blob([JSON.stringify(payload, null, 2)], { type: 'application/json' });
    const url = URL.createObjectURL(blob);
    const link = document.createElement('a');
    link.href = url;
    link.download = filename;
    link.click();
    URL.revokeObjectURL(url);
  };

  const startCountdown = () => {
    const el = document.querySelector<HTMLElement>('[data-countdown]');
    if (!el) return;

    window.clearInterval(countdownTimer);
    let remaining = Number(el.dataset.countdown || '12') * 60;

    const render = () => {
      const minutes = Math.floor(remaining / 60)
        .toString()
        .padStart(2, '0');
      const seconds = (remaining % 60).toString().padStart(2, '0');
      el.textContent = `${minutes}:${seconds}`;
    };

    render();
    countdownTimer = window.setInterval(() => {
      remaining = remaining > 0 ? remaining - 1 : 0;
      render();
      if (remaining === 0) window.clearInterval(countdownTimer);
    }, 1000);
  };

  const formatDate = (iso: string) =>
    new Date(iso).toLocaleDateString('ru-RU', { day: '2-digit', month: 'long', year: 'numeric' });

  const showAccount = (user: StoredUser) => {
    if (!guestView || !accountView) return;

    guestView.hidden = true;
    accountView.hidden = false;

    document.querySelectorAll<HTMLElement>('[data-user-nick]').forEach((element) => {
      element.textContent = user.nickname;
    });
    document.querySelectorAll<HTMLElement>('[data-user-email]').forEach((element) => {
      element.textContent = user.email;
    });
    document.querySelectorAll<HTMLElement>('[data-user-created]').forEach((element) => {
      element.textContent = formatDate(user.created);
    });
    document.querySelectorAll<HTMLElement>('[data-avatar]').forEach((element) => {
      element.textContent = user.nickname.slice(0, 1).toUpperCase();
    });

    if (nickInput) nickInput.value = user.nickname;
    applyPrefs(user.email);
    applyActivePreset(user.email);
    renderFriends(user.email);

    const hash = window.location.hash.replace('#', '');
    const panel = PANELS.find((value) => value === hash);
    openPanel(panel ?? 'overview', !panel);

    window.scrollTo({ top: 0, behavior: 'smooth' });
  };

  const showGuest = (mode: Mode = 'login') => {
    if (!guestView || !accountView) return;
    accountView.hidden = true;
    guestView.hidden = false;
    const friendList = document.querySelector<HTMLElement>('[data-friend-list]');
    if (friendList) friendList.replaceChildren();
    updateFriendCounters();
    setMode(mode);
    window.scrollTo({ top: 0, behavior: 'smooth' });
  };

  const init = () => {
    guestView = pick<HTMLElement>('[data-view="guest"]');
    if (!guestView) return;

    accountView = pick<HTMLElement>('[data-view="account"]');
    tabsRoot = pick<HTMLElement>('[data-auth-tabs]');
    loginForm = pick<HTMLFormElement>('[data-form="login"]');
    registerForm = pick<HTMLFormElement>('[data-form="register"]');
    titleEl = pick<HTMLElement>('[data-auth-title]');
    subtitleEl = pick<HTMLElement>('[data-auth-subtitle]');
    errorEl = pick<HTMLElement>('[data-auth-error]');
    noticeEl = pick<HTMLElement>('[data-auth-notice]');
    nickInput = pick<HTMLInputElement>('[data-nick-input]');
    nickNote = pick<HTMLElement>('[data-nick-note]');

    const user = currentUser();
    if (user) {
      showAccount(user);
      accountView?.querySelectorAll<HTMLElement>('.acc-reveal').forEach((element) => {
        element.style.animation = 'none';
        void element.offsetWidth;
        element.style.animation = '';
      });
    } else {
      guestView.hidden = false;
      if (accountView) accountView.hidden = true;
      setMode(window.location.hash === '#register' ? 'register' : 'login');
    }

    startCountdown();
  };

  /* ── Events (delegated so client-side navigation keeps working) ───── */
  document.addEventListener('click', (event) => {
    const target = event.target as HTMLElement | null;
    if (!target) return;

    const navTab = target.closest<HTMLElement>('[data-acc-tab]');
    if (navTab?.dataset.accTab && (PANELS as readonly string[]).includes(navTab.dataset.accTab)) {
      event.preventDefault();
      openPanel(navTab.dataset.accTab as Panel);
      return;
    }

    const tab = target.closest<HTMLElement>('[data-tab]');
    if (tab?.dataset.tab === 'login' || tab?.dataset.tab === 'register') {
      event.preventDefault();
      setMode(tab.dataset.tab);
      return;
    }

    const eye = target.closest<HTMLElement>('[data-pass-toggle]');
    if (eye) {
      const input = eye.parentElement?.querySelector<HTMLInputElement>('input');
      if (!input) return;
      const isHidden = input.type === 'password';
      input.type = isHidden ? 'text' : 'password';
      eye.querySelector('.eye-open')?.classList.toggle('hidden', isHidden);
      eye.querySelector('.eye-closed')?.classList.toggle('hidden', !isHidden);
      eye.setAttribute('aria-label', isHidden ? 'Скрыть пароль' : 'Показать пароль');
      return;
    }

    if (target.closest('[data-forgot]')) {
      showNotice('В демо-версии восстановление пароля недоступно. Создай новый аккаунт или напиши в поддержку.');
      return;
    }

    if (target.closest('[data-logout]')) {
      logout();
      nickNote?.classList.add('hidden');
      showGuest('login');
      return;
    }

    /* Friends */
    const friendRemove = target.closest<HTMLElement>('[data-friend-remove]');
    if (friendRemove) {
      friendRemove.closest<HTMLElement>('[data-friend]')?.remove();
      persistFriends();
      updateFriendCounters();
      return;
    }

    const invite = target.closest<HTMLButtonElement>('[data-friend-invite]');
    if (invite) {
      invite.textContent = 'Отправлено';
      invite.disabled = true;
      window.setTimeout(() => {
        invite.textContent = 'Пригласить';
        invite.disabled = false;
      }, 2400);
      return;
    }

    const accept = target.closest<HTMLElement>('[data-request-accept]');
    if (accept) {
      const request = accept.closest<HTMLElement>('[data-request]');
      const nick = request?.querySelector<HTMLElement>('[data-request-name]')?.textContent?.trim() || 'Игрок';
      request?.remove();
      addFriendRow(nick, true, true);
      updateFriendCounters();
      showPanelNote('friends', `${nick} добавлен в друзья.`);
      return;
    }

    const decline = target.closest<HTMLElement>('[data-request-decline]');
    if (decline) {
      const request = decline.closest<HTMLElement>('[data-request]');
      const nick = request?.querySelector<HTMLElement>('[data-request-name]')?.textContent?.trim() || 'Игрок';
      request?.remove();
      updateFriendCounters();
      showPanelNote('friends', `Заявка от ${nick} отклонена.`);
      return;
    }

    /* Configs */
    const activate = target.closest<HTMLElement>('[data-preset-activate]');
    if (activate) {
      const card = activate.closest<HTMLElement>('[data-preset]');
      const name = card?.dataset.name;
      if (!name) return;
      setActivePreset(name);
      const user = currentUser();
      if (user) localStorage.setItem(PRESET_PREFIX + user.email, name);
      showPanelNote('configs', `Конфиг «${name}» активирован.`);
      return;
    }

    const download = target.closest<HTMLElement>('[data-preset-download]');
    if (download) {
      const card = download.closest<HTMLElement>('[data-preset]');
      const name = card?.dataset.name;
      if (!name) return;
      const meta = card?.querySelector<HTMLElement>('[data-preset-meta]')?.textContent?.trim() || '';
      downloadJson(`${name.replace(/\s+/g, '-').toLowerCase()}.json`, {
        preset: name,
        meta,
        modules: [],
        exportedAt: new Date().toISOString(),
      });
      return;
    }

    if (target.closest('[data-export-configs]')) {
      const presets = Array.from(document.querySelectorAll<HTMLElement>('[data-preset]')).map((card) => ({
        name: card.dataset.name || 'preset',
        meta: card.querySelector<HTMLElement>('[data-preset-meta]')?.textContent?.trim() || '',
        active: card.dataset.active === 'true',
      }));
      downloadJson('amethyst-configs.json', { presets, exportedAt: new Date().toISOString() });
      return;
    }

    /* FunTime events */
    const filter = target.closest<HTMLElement>('[data-event-filter]');
    if (filter) {
      const value = filter.dataset.eventFilter || 'all';
      document.querySelectorAll<HTMLElement>('[data-event-filter]').forEach((button) => {
        button.dataset.active = String(button === filter);
      });
      document.querySelectorAll<HTMLElement>('[data-event]').forEach((card) => {
        card.hidden = value !== 'all' && card.dataset.cat !== value;
      });
      return;
    }

    const remind = target.closest<HTMLButtonElement>('[data-event-remind]');
    if (remind) {
      const on = remind.dataset.on === 'true';
      remind.dataset.on = String(!on);
      const label = remind.querySelector<HTMLElement>('[data-remind-label]');
      if (label) label.textContent = on ? 'Напомнить' : 'Напоминание включено';
      return;
    }
  });

  document.addEventListener('change', (event) => {
    const input = event.target as HTMLInputElement | null;
    if (!input?.matches('[data-sync]')) return;

    const user = currentUser();
    if (!user) return;

    const prefs = readPrefs(user.email);
    prefs[input.dataset.sync || ''] = input.checked;
    localStorage.setItem(PREF_PREFIX + user.email, JSON.stringify(prefs));
  });

  document.addEventListener(
    'submit',
    async (event) => {
      const form = event.target as HTMLFormElement | null;
      if (!form) return;

      if (form.matches('[data-form="login"]')) {
        event.preventDefault();
        clearMessages();
        const submit = form.querySelector<HTMLButtonElement>('button[type="submit"]');
        if (submit) submit.disabled = true;

        try {
          const data = new FormData(form);
          const user = await loginUser(String(data.get('email') || ''), String(data.get('password') || ''));
          showAccount(user);
        } catch (error) {
          showError(error instanceof Error ? error.message : 'Не удалось войти.');
        } finally {
          if (submit) submit.disabled = false;
        }
        return;
      }

      if (form.matches('[data-form="register"]')) {
        event.preventDefault();
        clearMessages();
        const submit = form.querySelector<HTMLButtonElement>('button[type="submit"]');
        const data = new FormData(form);

        if (!data.get('terms')) {
          showError('Подтверди согласие с условиями и политикой.');
          return;
        }

        if (submit) submit.disabled = true;

        try {
          const user = await registerUser({
            nickname: String(data.get('nickname') || ''),
            email: String(data.get('email') || ''),
            password: String(data.get('password') || ''),
          });
          showAccount(user);
        } catch (error) {
          showError(error instanceof Error ? error.message : 'Не удалось создать аккаунт.');
        } finally {
          if (submit) submit.disabled = false;
        }
        return;
      }

      if (form.matches('[data-friend-form]')) {
        event.preventDefault();
        const input = form.querySelector<HTMLInputElement>('input[name="nickname"]');
        const nick = input?.value.trim() || '';
        if (!/^[A-Za-z0-9_]{3,16}$/.test(nick)) {
          showPanelNote('friends', 'Никнейм должен быть от 3 до 16 символов: A-Z, 0-9, _.', 'error');
          return;
        }
        addFriendRow(nick, false, true);
        if (input) input.value = '';
        showPanelNote('friends', `${nick} добавлен в друзья.`);
        return;
      }

      if (form.matches('[data-config-form]')) {
        event.preventDefault();
        const input = form.querySelector<HTMLInputElement>('input[name="name"]');
        const name = input?.value.trim() || '';
        if (name.length < 2) {
          showPanelNote('configs', 'Введи название конфига.', 'error');
          return;
        }
        addPresetCard(name);
        if (input) input.value = '';
        showPanelNote('configs', `Конфиг «${name}» создан.`);
        return;
      }

      if (form.matches('[data-nick-form]')) {
        event.preventDefault();
        const user = currentUser();
        if (!user || !nickInput) return;

        try {
          const updated = updateNickname(user.email, nickInput.value);
          document.querySelectorAll<HTMLElement>('[data-user-nick]').forEach((element) => {
            element.textContent = updated.nickname;
          });
          document.querySelectorAll<HTMLElement>('[data-avatar]').forEach((element) => {
            element.textContent = updated.nickname.slice(0, 1).toUpperCase();
          });
          if (nickNote) {
            nickNote.textContent = 'Никнейм обновлён.';
            nickNote.classList.remove('text-red-300');
            nickNote.classList.add('text-emerald-300');
            nickNote.classList.remove('hidden');
            window.clearTimeout(nickNoteTimer);
            nickNoteTimer = window.setTimeout(() => nickNote?.classList.add('hidden'), 2600);
          }
        } catch (error) {
          if (nickNote) {
            nickNote.textContent = error instanceof Error ? error.message : 'Не удалось сохранить.';
            nickNote.classList.remove('hidden');
            nickNote.classList.remove('text-emerald-300');
            nickNote.classList.add('text-red-300');
            window.clearTimeout(nickNoteTimer);
            nickNoteTimer = window.setTimeout(() => nickNote?.classList.add('hidden'), 3000);
          }
        }
      }
    },
    // Capture phase: run before Astro's client router submit hook so it sees
    // `defaultPrevented` and never turns a login into a GET navigation.
    true
  );

  init();
  document.addEventListener('astro:page-load', init);
</script>
