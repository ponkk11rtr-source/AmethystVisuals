---
import PageLayout from '~/layouts/PageLayout.astro';

import { Icon } from 'astro-icon/components';
import { Image } from 'astro:assets';

import crystal from '~/assets/images/amethyst-crystal.png';
import { getHomePermalink, getPermalink } from '~/utils/permalinks';

const metadata = {
  title: 'Аккаунт — AmethystVisuals',
  description:
    'Войди в Amethyst ID или создай аккаунт: косметика, конфиги и раскладка HUD синхронизируются между устройствами.',
  ignoreTitleTemplate: true,
};

const perks = [
  {
    icon: 'tabler:cloud-check',
    title: 'Облачная синхронизация',
    text: 'Косметика, пресеты и HUD переезжают на любое устройство.',
  },
  {
    icon: 'tabler:shield-check',
    title: 'Пароль под защитой',
    text: 'В хранилище попадает только SHA-256 хеш, а не сам пароль.',
  },
  {
    icon: 'tabler:gift',
    title: 'Бонус за регистрацию',
    text: 'Стартовый набор косметики активируется сразу.',
  },
];

const collection = [
  { value: '535', label: 'косметики' },
  { value: '32', label: 'модуля' },
  { value: '12', label: 'пресетов' },
  { value: '8', label: 'друзей' },
];

const syncRows = [
  { key: 'cosmetics', label: 'Косметика', hint: 'капы, скины, крылья' },
  { key: 'presets', label: 'Пресеты', hint: 'конфиги модулей' },
  { key: 'hud', label: 'Раскладка HUD', hint: 'позиции и темы' },
  { key: 'friends', label: 'Друзья', hint: 'список и онлайн' },
];

const presets = [
  {
    name: 'Amethyst Night',
    meta: '28 модулей · HUD + шейдеры',
    tone: 'from-violet-600/50 to-fuchsia-600/30',
    active: true,
  },
  {
    name: 'PvP Clean',
    meta: '14 модулей · минимализм',
    tone: 'from-sky-500/40 to-indigo-600/25',
    active: false,
  },
  {
    name: 'Neon HUD',
    meta: '22 модуля · неоновая тема',
    tone: 'from-fuchsia-500/40 to-rose-500/25',
    active: false,
  },
  {
    name: 'Cinematic',
    meta: '19 модулей · шейдеры и эффекты',
    tone: 'from-emerald-500/35 to-teal-600/25',
    active: false,
  },
];

const ftEvents = [
  {
    name: 'Вулкан',
    icon: 'tabler:volcano',
    rarity: 'Элитный',
    rarityClass: 'border-fuchsia-400/30 bg-fuchsia-400/10 text-fuchsia-300',
    tone: 'from-orange-500/35 to-rose-600/20',
    cat: 'pvp',
    desc: 'Извержение раскрывает жилы ресурсов — успей собрать их до лавы.',
    time: 'через 40 мин',
    server: 'Survival',
    reward: 'Незерит, изумруды, кит',
  },
  {
    name: 'Гейзер',
    icon: 'tabler:droplets',
    rarity: 'Богатый',
    rarityClass: 'border-violet-400/30 bg-violet-400/10 text-violet-300',
    tone: 'from-sky-500/35 to-cyan-600/20',
    cat: 'drop',
    desc: 'Гейзеры выбрасывают руду и кристаллы прямо на поверхность.',
    time: 'через 1 ч 10 мин',
    server: 'SkyBlock',
    reward: 'Руда, кристаллы, монеты',
  },
  {
    name: 'Алтарь',
    icon: 'tabler:torii',
    rarity: 'Элитный',
    rarityClass: 'border-fuchsia-400/30 bg-fuchsia-400/10 text-fuchsia-300',
    tone: 'from-fuchsia-500/35 to-purple-600/20',
    cat: 'pvp',
    desc: 'Активируй алтарь и удержи его до конца таймера.',
    time: 'через 2 ч',
    server: 'Анархия',
    reward: 'Ключи, зачарованные книги',
  },
  {
    name: 'Маяк',
    icon: 'tabler:broadcast',
    rarity: 'Солидный',
    rarityClass: 'border-sky-400/30 bg-sky-400/10 text-sky-300',
    tone: 'from-sky-500/30 to-blue-600/20',
    cat: 'pvp',
    desc: 'Захвати маяк и удержи позицию под давлением других команд.',
    time: 'через 3 ч',
    server: 'BedWars',
    reward: 'Бустеры, токены',
  },
  {
    name: 'Мистический алтарь',
    icon: 'tabler:sparkles',
    rarity: 'Легендарный',
    rarityClass: 'border-amber-400/35 bg-amber-400/10 text-amber-300',
    tone: 'from-amber-500/30 to-fuchsia-600/20',
    cat: 'rare',
    desc: 'Редчайший ивент с мифическим лутом и уникальной косметикой.',
    time: 'сегодня 21:00',
    server: 'Survival',
    reward: 'Мифический лут, косметика',
  },
  {
    name: 'Метеорит',
    icon: 'tabler:meteor',
    rarity: 'Богатый',
    rarityClass: 'border-violet-400/30 bg-violet-400/10 text-violet-300',
    tone: 'from-violet-500/35 to-indigo-600/20',
    cat: 'drop',
    desc: 'Метеорит падает и создаёт кратер с редкими рудами.',
    time: 'через 4 ч',
    server: 'Анархия',
    reward: 'Древние обломки, алмазы',
  },
  {
    name: 'Сундук смерти',
    icon: 'tabler:skull',
    rarity: 'Обычный',
    rarityClass: 'border-white/20 bg-white/5 text-white/60',
    tone: 'from-slate-500/30 to-zinc-600/20',
    cat: 'drop',
    desc: 'На месте гибели игрока появляется сундук с его лутом.',
    time: 'через 25 мин',
    server: 'Анархия',
    reward: 'Лут погибшего игрока',
  },
  {
    name: 'Аирдроп',
    icon: 'tabler:parachute',
    rarity: 'Легендарный',
    rarityClass: 'border-amber-400/35 bg-amber-400/10 text-amber-300',
    tone: 'from-amber-500/35 to-orange-600/20',
    cat: 'rare',
    desc: 'Сундуки с лутом падают на спавн — первый забравший получает всё.',
    time: 'через 12 мин',
    server: 'Анархия',
    reward: 'Алмазы, незерит, кит',
  },
];

const eventFilters = [
  { value: 'all', label: 'Все' },
  { value: 'drop', label: 'Дроп' },
  { value: 'pvp', label: 'PvP' },
  { value: 'rare', label: 'Легендарные' },
];
---

<PageLayout metadata={metadata}>
  <!-- Background -->
  <div class="pointer-events-none absolute inset-x-0 top-0 -z-10 h-[900px] overflow-hidden" aria-hidden="true">
    <div class="acc-blob acc-blob--violet"></div>
    <div class="acc-blob acc-blob--fuchsia"></div>
    <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_top,transparent_25%,#06040f_75%)]"></div>
  </div>

  <section class="relative pb-20 pt-28 md:pb-28 md:pt-36">
    <div class="mx-auto max-w-6xl px-4 sm:px-6">
      <!-- ══ GUEST: AUTH ═══════════════════════════════════════════════ -->
      <div data-view="guest">
        <div class="grid gap-6 lg:grid-cols-[1.02fr_0.98fr]">
          <!-- Auth card -->
          <section class="acc-card acc-reveal relative overflow-hidden p-6 sm:p-8">
            <div
              class="pointer-events-none absolute -right-16 -top-16 h-48 w-48 rounded-full bg-violet-600/20 blur-3xl"
              aria-hidden="true"
            >
            </div>

            <div class="relative flex items-center justify-between">
              <a href={getHomePermalink()} class="inline-flex items-center gap-2.5 text-sm font-semibold text-white">
                <Image src={crystal} alt="" width={32} height={32} class="h-7 w-7" />
                AmethystVisuals
              </a>
              <a href={getHomePermalink()} class="text-xs text-white/40 transition-colors hover:text-white"
                >На главную →</a
              >
            </div>

            <div
              class="auth-tabs relative mt-7 grid grid-cols-2 rounded-xl border border-white/10 bg-white/[0.04] p-1"
              data-mode="login"
              data-auth-tabs
              role="tablist"
              aria-label="Вход или регистрация"
            >
              <span class="auth-tab-indicator" aria-hidden="true"></span>
              <button
                type="button"
                class="auth-tab"
                data-tab="login"
                data-active="true"
                role="tab"
                aria-selected="true"
              >
                Вход
              </button>
              <button
                type="button"
                class="auth-tab"
                data-tab="register"
                data-active="false"
                role="tab"
                aria-selected="false">Регистрация</button
              >
            </div>

            <div class="mt-7">
              <h1 class="text-2xl font-bold tracking-tight text-white sm:text-3xl" data-auth-title>С возвращением</h1>
              <p class="mt-1.5 text-sm text-white/50" data-auth-subtitle>
                Войди, чтобы забрать сетап на любое устройство.
              </p>
            </div>

            <!-- Login -->
            <form class="auth-form mt-6 space-y-4" data-form="login" data-astro-reload novalidate>
              <label class="acc-field">
                <span class="acc-field-label">Email</span>
                <span class="acc-input-wrap">
                  <Icon name="tabler:mail" class="acc-input-icon" />
                  <input
                    type="email"
                    name="email"
                    autocomplete="email"
                    placeholder="you@example.com"
                    class="acc-input"
                  />
                </span>
              </label>

              <label class="acc-field">
                <span class="acc-field-label">Пароль</span>
                <span class="acc-input-wrap">
                  <Icon name="tabler:lock" class="acc-input-icon" />
                  <input
                    type="password"
                    name="password"
                    autocomplete="current-password"
                    placeholder="••••••••"
                    class="acc-input"
                  />
                  <button type="button" class="acc-eye" data-pass-toggle aria-label="Показать пароль">
                    <Icon name="tabler:eye" class="eye-open h-4 w-4" />
                    <Icon name="tabler:eye-off" class="eye-closed hidden h-4 w-4" />
                  </button>
                </span>
              </label>

              <div class="flex items-center justify-between gap-3 text-xs">
                <label class="inline-flex cursor-pointer items-center gap-2 text-white/50">
                  <input type="checkbox" name="remember" checked class="acc-checkbox" />
                  Запомнить меня
                </label>
                <button type="button" class="text-violet-300 transition-colors hover:text-violet-200" data-forgot>
                  Забыли пароль?
                </button>
              </div>

              <button type="submit" class="btn btn-amethyst w-full !py-3.5 text-sm">
                Войти
                <Icon name="tabler:arrow-right" class="ml-2 h-4 w-4" />
              </button>
            </form>

            <!-- Register -->
            <form class="auth-form mt-6 space-y-4" data-form="register" data-astro-reload hidden novalidate>
              <label class="acc-field">
                <span class="acc-field-label">Никнейм</span>
                <span class="acc-input-wrap">
                  <Icon name="tabler:user" class="acc-input-icon" />
                  <input type="text" name="nickname" autocomplete="nickname" placeholder="Steve" class="acc-input" />
                </span>
              </label>

              <label class="acc-field">
                <span class="acc-field-label">Email</span>
                <span class="acc-input-wrap">
                  <Icon name="tabler:mail" class="acc-input-icon" />
                  <input
                    type="email"
                    name="email"
                    autocomplete="email"
                    placeholder="you@example.com"
                    class="acc-input"
                  />
                </span>
              </label>

              <label class="acc-field">
                <span class="acc-field-label">Пароль</span>
                <span class="acc-input-wrap">
                  <Icon name="tabler:lock" class="acc-input-icon" />
                  <input
                    type="password"
                    name="password"
                    autocomplete="new-password"
                    placeholder="Минимум 6 символов"
                    class="acc-input"
                  />
                  <button type="button" class="acc-eye" data-pass-toggle aria-label="Показать пароль">
                    <Icon name="tabler:eye" class="eye-open h-4 w-4" />
                    <Icon name="tabler:eye-off" class="eye-closed hidden h-4 w-4" />
                  </button>
                </span>
              </label>

              <label class="flex cursor-pointer items-start gap-2.5 text-xs leading-relaxed text-white/45">
                <input type="checkbox" name="terms" class="acc-checkbox mt-0.5" />
                <span>
                  Соглашаюсь с
                  <a href={getPermalink('/terms')} class="text-violet-300 underline-offset-2 hover:underline"
                    >условиями</a
                  > и
                  <a href={getPermalink('/privacy')} class="text-violet-300 underline-offset-2 hover:underline"
                    >политикой</a
                  >
                  конфиденциальности.
                </span>
              </label>

              <button type="submit" class="btn btn-amethyst w-full !py-3.5 text-sm">
                Создать аккаунт
                <Icon name="tabler:arrow-right" class="ml-2 h-4 w-4" />
              </button>
            </form>

            <div class="mt-4">
              <p
                data-auth-error
                class="hidden rounded-xl border border-red-500/30 bg-red-500/10 px-3.5 py-2.5 text-xs text-red-300"
              >
              </p>
              <p
                data-auth-notice
                class="hidden rounded-xl border border-violet-400/30 bg-violet-500/10 px-3.5 py-2.5 text-xs text-violet-200"
              >
              </p>
            </div>

            <div class="mt-6 flex items-center gap-3 text-[0.68rem] uppercase tracking-[0.2em] text-white/25">
              <span class="h-px flex-1 bg-white/10"></span>
              или
              <span class="h-px flex-1 bg-white/10"></span>
            </div>

            <a href={getHomePermalink()} class="btn btn-ghost mt-4 w-full !py-3 text-sm">
              <Icon name="tabler:player-play" class="mr-2 h-4 w-4" />
              Продолжить без аккаунта
            </a>

            <p class="mt-4 text-center text-[0.68rem] leading-relaxed text-white/30">
              Демо-аккаунт: данные хранятся только в этом браузере. Не используй реальный пароль.
            </p>
          </section>

          <!-- Visual -->
          <aside class="acc-aside acc-reveal hidden overflow-hidden rounded-3xl p-8 lg:flex lg:flex-col">
            <div>
              <span class="eyebrow">Amethyst ID</span>
              <h2 class="mt-5 text-3xl font-extrabold leading-tight tracking-tight text-white">
                Один аккаунт.<br />
                <span class="gradient-text">Весь твой сетап.</span>
              </h2>
              <p class="mt-3 max-w-sm text-sm leading-relaxed text-white/55">
                Настрой клиент один раз — и забери косметику, конфиги и раскладку HUD на любое устройство.
              </p>
            </div>

            <div class="relative mx-auto my-8 w-full max-w-[240px]">
              <div class="absolute inset-4 animate-glow rounded-full bg-violet-600/35 blur-3xl" aria-hidden="true">
              </div>
              <div class="acc-orbit" aria-hidden="true"></div>
              <Image
                src={crystal}
                alt="Кристалл AmethystVisuals"
                width={320}
                height={320}
                class="relative mx-auto w-40 animate-float drop-shadow-[0_24px_60px_rgba(139,92,246,0.55)] sm:w-48"
              />
            </div>

            <ul class="mt-auto space-y-3">
              {
                perks.map((perk) => (
                  <li class="flex items-start gap-3 rounded-xl border border-white/5 bg-white/[0.03] px-3.5 py-3">
                    <span class="mt-0.5 inline-flex h-8 w-8 shrink-0 items-center justify-center rounded-lg bg-violet-500/15 text-violet-200 ring-1 ring-inset ring-violet-400/25">
                      <Icon name={perk.icon} class="h-4 w-4" />
                    </span>
                    <div>
                      <p class="text-sm font-medium text-white/90">{perk.title}</p>
                      <p class="text-xs leading-relaxed text-white/45">{perk.text}</p>
                    </div>
                  </li>
                ))
              }
            </ul>
          </aside>
        </div>
      </div>

      <!-- ══ LOGGED IN: DASHBOARD ══════════════════════════════════════ -->
      <div data-view="account" hidden>
        <div class="acc-reveal flex flex-col gap-6 md:flex-row md:items-center md:justify-between">
          <div class="flex items-center gap-4">
            <span class="acc-avatar" data-avatar>A</span>
            <div class="min-w-0">
              <span class="eyebrow">Amethyst ID</span>
              <h1 class="mt-2 truncate text-3xl font-extrabold tracking-tight text-white sm:text-4xl">
                Привет, <span class="gradient-text" data-user-nick>—</span>
              </h1>
              <p class="truncate text-sm text-white/45" data-user-email>—</p>
            </div>
          </div>

          <div class="flex flex-wrap gap-2">
            <a href={getPermalink('/#download')} class="btn btn-amethyst !px-5 !py-3 text-sm">
              <Icon name="tabler:download" class="mr-2 h-4 w-4" />
              Скачать лаунчер
            </a>
            <button type="button" data-logout class="btn btn-ghost !px-5 !py-3 text-sm">
              <Icon name="tabler:logout" class="mr-2 h-4 w-4" />
              Выйти
            </button>
          </div>
        </div>

        <div class="mt-8 grid gap-4 lg:grid-cols-[248px_minmax(0,1fr)] lg:items-start">
          <!-- Sidebar -->
          <aside class="acc-card p-2.5 lg:sticky lg:top-24" aria-label="Разделы аккаунта">
            <div class="flex items-center gap-2 px-3 pb-2 pt-2">
              <span class="h-1.5 w-1.5 rounded-full bg-violet-400"></span>
              <span class="text-[0.65rem] font-semibold uppercase tracking-[0.2em] text-white/35">Кабинет</span>
            </div>

            <nav
              class="flex gap-1 overflow-x-auto pb-1 lg:flex-col lg:overflow-visible lg:pb-0"
              role="tablist"
              aria-label="Разделы аккаунта"
            >
              <button
                type="button"
                class="acc-nav-item"
                data-acc-tab="overview"
                data-active="true"
                role="tab"
                aria-selected="true"
              >
                <span class="acc-nav-icon"><Icon name="tabler:user" class="h-4 w-4" /></span>
                <span class="flex-1 text-left">Аккаунт</span>
              </button>
              <button
                type="button"
                class="acc-nav-item"
                data-acc-tab="friends"
                data-active="false"
                role="tab"
                aria-selected="false"
              >
                <span class="acc-nav-icon"><Icon name="tabler:users" class="h-4 w-4" /></span>
                <span class="flex-1 text-left">Друзья</span>
                <span class="acc-nav-badge" data-friends-badge>0</span>
              </button>
              <button
                type="button"
                class="acc-nav-item"
                data-acc-tab="configs"
                data-active="false"
                role="tab"
                aria-selected="false"
              >
                <span class="acc-nav-icon"><Icon name="tabler:adjustments" class="h-4 w-4" /></span>
                <span class="flex-1 text-left">Конфиги</span>
                <span class="acc-nav-badge" data-configs-badge>{presets.length}</span>
              </button>
              <button
                type="button"
                class="acc-nav-item"
                data-acc-tab="events"
                data-active="false"
                role="tab"
                aria-selected="false"
              >
                <span class="acc-nav-icon"><Icon name="tabler:sparkles" class="h-4 w-4" /></span>
                <span class="flex-1 text-left">Ивенты FT</span>
                <span class="acc-nav-live">LIVE</span>
              </button>
            </nav>

            <div
              class="mt-2 hidden rounded-xl border border-violet-400/20 bg-gradient-to-br from-violet-600/15 to-transparent p-3.5 lg:block"
            >
              <p class="text-[0.62rem] uppercase tracking-[0.18em] text-white/35">Подписка</p>
              <p class="mt-1 text-sm font-semibold text-white">Free · 0 ₽</p>
              <p class="text-[0.68rem] text-white/40">все базовые функции</p>
              <a
                href={getPermalink('/#pricing')}
                class="mt-2.5 inline-flex text-[0.7rem] font-medium text-violet-300 hover:text-violet-200"
              >
                Улучшить →
              </a>
            </div>

            <button
              type="button"
              data-open-chat
              class="mt-2 hidden w-full items-center justify-center gap-2 rounded-xl border border-white/10 bg-white/[0.03] px-3 py-2.5 text-xs text-white/60 transition hover:border-violet-400/40 hover:text-white lg:flex"
            >
              <Icon name="tabler:message-circle" class="h-4 w-4" />
              Поддержка 24/7
            </button>
          </aside>

          <div class="min-w-0">
            <section data-acc-panel="overview" class="acc-panel" role="tabpanel">
              <div class="grid gap-4 lg:grid-cols-3">
                <!-- Plan -->
                <article class="acc-card acc-reveal p-6" style="animation-delay: 60ms">
                  <div class="flex items-center justify-between">
                    <span class="text-[0.68rem] font-semibold uppercase tracking-[0.18em] text-white/40">Тариф</span>
                    <span
                      class="rounded-full bg-violet-500/15 px-3 py-1 text-[0.65rem] font-bold uppercase tracking-[0.14em] text-violet-200 ring-1 ring-inset ring-violet-400/30"
                      >Free</span
                    >
                  </div>
                  <p class="gradient-text mt-4 text-4xl font-extrabold">0 ₽</p>
                  <p class="text-xs text-white/40">навсегда · без карты</p>
                  <ul class="mt-4 space-y-2 text-sm text-white/60">
                    <li class="flex items-center gap-2">
                      <Icon name="tabler:check" class="h-4 w-4 text-violet-300" /> 32 модуля
                    </li>
                    <li class="flex items-center gap-2">
                      <Icon name="tabler:check" class="h-4 w-4 text-violet-300" /> Редактор HUD и темы
                    </li>
                    <li class="flex items-center gap-2">
                      <Icon name="tabler:check" class="h-4 w-4 text-violet-300" /> Стартовая косметика
                    </li>
                  </ul>
                  <a
                    href={getPermalink('/#pricing')}
                    class="mt-5 inline-flex text-xs font-medium text-violet-300 hover:text-violet-200"
                  >
                    Все возможности →
                  </a>
                </article>

                <!-- Collection -->
